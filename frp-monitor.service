[Unit]
Description=FRP Host Online Monitor
After=network-online.target frps.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/frp-monitor
ExecStart=/usr/bin/python3 /opt/frp-monitor/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
